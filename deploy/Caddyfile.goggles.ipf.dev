goggles.ipf.dev {
	# Must sit ABOVE Django's GOGGLES_MAX_DUMP_BYTES (64 MiB) so the 413 for an
	# oversized upload is decided by Django -- which records it as an
	# UploadRejection -- rather than dying here with no server-side trace.
	# Caddy units: "MB" is decimal (50MB was 50,000,000 bytes, below Django's
	# old 50 MiB), "MiB" is binary. The margin covers multipart framing.
	request_body {
		max_size 68MiB
	}

	# Edge access log: the only place a request that never reaches Django (a
	# body over max_size, a client that disconnected) leaves a record. Bearer
	# tokens, cookies, the group ref, and the human device label are stripped;
	# the client IP and user agent remain because a 413 investigation groups by
	# them, so the file is age-bounded to the audit retention window (14 days,
	# GOGGLES_AUDIT_RETENTION_DAYS) rather than kept until it rolls by size.
	# Status, size, duration, and the client platform/version headers stay.
	log {
		output file /var/log/caddy/goggles-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Goggles-Group delete
				request>headers>X-Goggles-Device-Label delete
			}
		}
	}

	encode zstd gzip

	handle_path /static/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
