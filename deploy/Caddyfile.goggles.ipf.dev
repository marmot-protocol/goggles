goggles.ipf.dev {
	# Must sit ABOVE Django's GOGGLES_MAX_DUMP_BYTES (64 MiB) so the 413 for an
	# oversized upload is decided by Django -- which records it as an
	# UploadRejection -- rather than dying here with no server-side trace.
	# Caddy units: "MB" is decimal (50MB was 50,000,000 bytes, below Django's
	# old 50 MiB), "MiB" is binary. The margin covers multipart framing.
	request_body {
		max_size 68MiB
	}

	# Operational diagnostics only: never retain request headers, URI, IP or body.
	log {
		output file /var/log/caddy/goggles-access.log {
			roll_at 00:00
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}

	encode zstd gzip

	@audit_upload {
		method POST
		path /api/v1/audit-logs/ /api/v1/groups/*/audit-logs/
	}
	handle @audit_upload {
		reverse_proxy 127.0.0.1:8002 {
			# Shed excess work instead of building an HTTP upload backlog.
			unhealthy_request_count 2
			transport http {
				dial_timeout 2s
				response_header_timeout 125s
			}
		}
	}

	handle_errors {
		@upload_unavailable {
			method POST
			path /api/v1/audit-logs/ /api/v1/groups/*/audit-logs/
			expression {http.error.status_code} in [502, 503, 504]
		}
		handle @upload_unavailable {
			header Retry-After 30
			respond "Audit ingestion unavailable; retry later." 503
		}
		handle {
			respond "{http.error.status_text}" {http.error.status_code}
		}
	}

	handle_path /static/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
